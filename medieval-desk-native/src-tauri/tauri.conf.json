{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.medievaldesk.desktop",
  "productName": "Medieval Desk",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Medieval Desk",
        "width": 1376,
        "height": 768,
        "resizable": true,
        "fullscreen": true,
        "maximized": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "focus": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' asset: data:; connect-src 'self' https://api.open-meteo.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
"plugins": {
    "fs": null,
    "shell": null,
    "opener": null,
    "global-shortcut": null,
    "clipboard-manager": null
}
}