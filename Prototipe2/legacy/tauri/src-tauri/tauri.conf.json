{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medieval Desk",
  "version": "0.1.0",
  "identifier": "com.medievaldesk.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "python -m http.server 1420 --directory ../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Medieval Desk",
        "width": 1280,
        "height": 672,
        "x": 0,
        "y": 0,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: blob: data: file:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Medieval RPG theme interactive desktop wallpaper",
    "resources": ["../assets/*"]
  }
}
