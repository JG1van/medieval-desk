<Window x:Class="MedievalDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medieval Desk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnWindowKeyDown">
  <Grid x:Name="RootGrid">
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="HighQuality" />

    <Canvas x:Name="HotspotLayer" />

    <Border x:Name="EditFrame" Visibility="Collapsed" IsHitTestVisible="False"
            BorderBrush="{DynamicResource Accent}" BorderThickness="2" Margin="4" CornerRadius="4" />

    <Border x:Name="SelectionBox" Visibility="Collapsed" IsHitTestVisible="False"
            BorderBrush="{DynamicResource Accent}" BorderThickness="2"
            Background="#33000000" HorizontalAlignment="Left" VerticalAlignment="Top" />

    <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="2"
            CornerRadius="10" Padding="26,16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="DropHintText" Foreground="{DynamicResource Ink}" FontSize="16" Text="Lepaskan gambar di hotspot" />
    </Border>

    <Border x:Name="StatusBanner" Visibility="Collapsed" IsHitTestVisible="False"
            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
            CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource Ink}" FontSize="13" TextWrapping="Wrap" MaxWidth="720" />
    </Border>

    <Border x:Name="ControlBar" Visibility="Collapsed"
            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
            CornerRadius="10" Padding="10,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Content="Simpan" Click="OnSaveClick" />
        <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Content="Ekspor" Click="OnExportClick" />
        <Button x:Name="ImportButton" Style="{StaticResource ToolButton}" Content="Impor" Click="OnImportClick" />
        <Button x:Name="ProfileButton" Style="{StaticResource ToolButton}" Content="Profil" Click="OnProfilesClick" />
        <Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Content="Tema" Click="OnThemeClick" />
        <Button x:Name="AddButton" Style="{StaticResource ToolButton}" Content="Tambah Hotspot" Click="OnAddHotspotClick" />
        <Button x:Name="EditButton" Style="{StaticResource ToolButton}" Content="Keluar Edit" Click="OnEditToggleClick" />
      </StackPanel>
    </Border>

    <Border x:Name="Popup" Visibility="Collapsed"
            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
            CornerRadius="9" Padding="10" HorizontalAlignment="Left" VerticalAlignment="Top"
            MinWidth="220" MaxWidth="360">
      <StackPanel>
        <TextBlock x:Name="PopupTitle" Style="{StaticResource SectionLabel}" FontSize="15" TextWrapping="Wrap" />
        <StackPanel x:Name="PopupItems" />
        <TextBlock x:Name="PopupHint" Foreground="{DynamicResource MutedInk}" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0" />
      </StackPanel>
    </Border>

    <Border x:Name="Lightbox" Visibility="Collapsed" Background="{DynamicResource Shade}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="12">
          <TextBlock x:Name="LightboxTitle" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="16"
                     VerticalAlignment="Center" Margin="0,0,14,0" />
          <Button Style="{StaticResource ToolButton}" Content="Sebelumnya" Click="OnLightboxPrev" />
          <Button Style="{StaticResource ToolButton}" Content="Berikutnya" Click="OnLightboxNext" />
          <Button x:Name="SlideButton" Style="{StaticResource ToolButton}" Content="Slideshow" Click="OnLightboxSlideshow" />
          <Button Style="{StaticResource ToolButton}" Content="Tutup" Click="OnLightboxClose" />
        </StackPanel>
        <Image x:Name="LightboxImage" Grid.Row="1" Stretch="Uniform" Margin="24"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="LightboxCounter" Grid.Row="2" Foreground="{DynamicResource Ink}" FontSize="13"
                   HorizontalAlignment="Center" Margin="12" />
      </Grid>
    </Border>
  </Grid>
</Window>
